# PATH: GovScheme/.env.example
FLASK_SECRET_KEY=replace-with-a-long-random-secret
FLASK_DEBUG=1
DATABASE_PATH=database/YojanaBharath.db
EXCEL_SOURCE_PATH=data/Government_Scheme_Eligibility_Upgraded.xlsx
ML_MODEL_PATH=ml_models/trained_model.joblib

# Optional LLM; local rule-based chatbot works without it.
LLM_PROVIDER=
LLM_API_KEY=

# Voice: browser_web_speech needs no key. For server STT/TTS use Azure.
STT_PROVIDER=browser_web_speech
STT_API_KEY=
STT_REGION=
TTS_PROVIDER=browser_web_speech
TTS_API_KEY=
TTS_REGION=

# Optional verified official JSON feed. Must be HTTPS .gov.in/.nic.in.
OFFICIAL_SCHEME_FEED_URL=
OFFICIAL_SCHEME_FEED_IS_COMPLETE=0
SCHEME_UPDATE_INTERVAL_HOURS=24

# Demo or UiPath.
RPA_MODE=DEMO
UIPATH_ORCHESTRATOR_URL=
UIPATH_ORCHESTRATOR_TENANT=
UIPATH_ORCHESTRATOR_CLIENT_ID=
UIPATH_ORCHESTRATOR_CLIENT_SECRET=
UIPATH_RELEASE_KEY=

# DigiLocker: official outbound/authorized integration only; no credentials collected.
DIGILOCKER_ENABLED=0
DIGILOCKER_AUTH_URL=https://www.digilocker.gov.in/
# Only fill these with values supplied by an authorized DigiLocker integration.
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
DIGILOCKER_TOKEN_URL=
DIGILOCKER_DOCUMENTS_URL=
DIGILOCKER_REDIRECT_URI=
DIGILOCKER_SCOPE=openid

ADMIN_EMAIL_1=tejaswinip1123@gmail.com
ADMIN_EMAIL_2=
ADMIN_EMAIL_3=
ADMIN_EMAIL_4=

# Optional email delivery for password-reset OTPs.
EMAIL_ADDRESS=
EMAIL_PASSWORD=

MAX_UPLOAD_MB=10

# Authentication / password reset (optional for local development)
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=1
MAIL_FROM=

# Theme / accessibility are stored per user; no API key required.
